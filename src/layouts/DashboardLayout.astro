---
import Layout from '@/layouts/Layout.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'BoomLab', description = 'Panel de control' } = Astro.props;
---

<Layout title={title} description={description}>
  <div class="mesh-gradient" id="dashboard-root" style="min-height: 100vh;">
    <slot name="nav" />
    <div id="dashboard-content" style="padding-bottom: 6rem;">
      <slot />
    </div>
  </div>

  <nav id="bottom-nav" style="position: fixed; bottom: 0; left: 0; right: 0; z-index: 50; display: flex; justify-content: center; padding: 1.5rem 1rem 0.75rem; background: linear-gradient(to top, #fdf8fb, #fdf8fb 90%, transparent); pointer-events: none;">
    <div style="pointer-events: auto; display: flex; align-items: flex-end; gap: 0.125rem; background: rgba(255,255,255,0.7); backdrop-filter: blur(24px); border: 1px solid rgba(245,220,233,0.8); border-radius: 1.5rem; padding: 0.5rem; box-shadow: 0 8px 40px rgba(180,80,140,0.14);">
      <button data-nav="dashboard" class="nav-btn active" onclick="window.location.href='/admin'" style="display: flex; flex-direction: column; align-items: center; gap: 0.25rem; padding: 0.625rem 1rem; border: none; border-radius: 1rem; cursor: pointer; transition: all 0.3s; font-size: 0.6875rem; font-weight: 600; color: #7d7599; background: transparent;">
        <svg viewBox="0 0 22 22" fill="none" style="width: 18px; height: 18px;" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="8" height="8" rx="2.5" /><rect x="12" y="2" width="8" height="8" rx="2.5" /><rect x="2" y="12" width="8" height="8" rx="2.5" /><rect x="12" y="12" width="8" height="8" rx="2.5" /></svg>
        <span style="display: none;" class="nav-label sm\:block">Dashboard</span>
      </button>
      <button data-nav="kanban" class="nav-btn" onclick="window.location.href='/proyectos'" style="display: flex; flex-direction: column; align-items: center; gap: 0.25rem; padding: 0.625rem 0.75rem; border: none; border-radius: 1rem; cursor: pointer; transition: all 0.3s; font-size: 0.6875rem; font-weight: 600; color: #7d7599; background: transparent;">
        <svg viewBox="0 0 22 22" fill="none" style="width: 18px; height: 18px;" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="5" height="18" rx="2" /><rect x="9" y="2" width="5" height="12" rx="2" /><rect x="16" y="2" width="5" height="15" rx="2" /></svg>
        <span style="display: none;" class="nav-label sm\:block">Proyectos</span>
      </button>
      <button data-nav="feedback" class="nav-btn" onclick="window.location.href='/feedback'" style="display: flex; flex-direction: column; align-items: center; gap: 0.25rem; padding: 0.625rem 0.75rem; border: none; border-radius: 1rem; cursor: pointer; transition: all 0.3s; font-size: 0.6875rem; font-weight: 600; color: #7d7599; background: transparent;">
        <svg viewBox="0 0 22 22" fill="none" style="width: 18px; height: 18px;" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 2H2v14h3v4l5-4h10V2z" /><path d="M6 8h10M6 11h6" /></svg>
        <span style="display: none;" class="nav-label sm\:block">Feedback</span>
      </button>
      <button data-nav="ia" class="nav-btn" onclick="window.location.href='/ia'" style="display: flex; flex-direction: column; align-items: center; gap: 0.25rem; padding: 0.625rem 0.75rem; border: none; border-radius: 1rem; cursor: pointer; transition: all 0.3s; font-size: 0.6875rem; font-weight: 600; color: #7d7599; background: transparent;">
        <svg viewBox="0 0 22 22" fill="none" style="width: 18px; height: 18px;" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="3" /><path d="M11 2v3M11 17v3M2 11h3M17 11h3" /><path d="M4.93 4.93l2.12 2.12M14.95 14.95l2.12 2.12M4.93 17.07l2.12-2.12M14.95 7.05l2.12-2.12" /></svg>
        <span style="display: none;" class="nav-label sm\:block">IA</span>
      </button>
      <button data-nav="settings" class="nav-btn" onclick="window.location.href='/ajustes'" style="display: flex; flex-direction: column; align-items: center; gap: 0.25rem; padding: 0.625rem 0.75rem; border: none; border-radius: 1rem; cursor: pointer; transition: all 0.3s; font-size: 0.6875rem; font-weight: 600; color: #7d7599; background: transparent;">
        <svg viewBox="0 0 22 22" fill="none" style="width: 18px; height: 18px;" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="2.8" /><path d="M11 1.5V4M11 18v2.5M1.5 11H4M18 11h2.5M4.22 4.22l1.77 1.77M16.01 16.01l1.77 1.77M4.22 17.78l1.77-1.77M16.01 5.99l1.77-1.77" /></svg>
        <span style="display: none;" class="nav-label sm\:block">Ajustes</span>
      </button>
      <button data-nav="logout" class="nav-btn" id="nav-logout" style="display: flex; flex-direction: column; align-items: center; gap: 0.25rem; padding: 0.625rem 0.75rem; border: none; border-radius: 1rem; cursor: pointer; transition: all 0.3s; font-size: 0.6875rem; font-weight: 600; color: #7d7599; background: transparent;">
        <svg viewBox="0 0 22 22" fill="none" style="width: 18px; height: 18px;" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" y1="12" x2="9" y2="12" /></svg>
        <span style="display: none;" class="nav-label sm\:block">Cerrar</span>
      </button>
    </div>
  </nav>
</Layout>

<script>
  const path = window.location.pathname;
  const navMap = {
    '/admin': 'dashboard',
    '/proyectos': 'kanban',
    '/feedback': 'feedback',
    '/ia': 'ia',
    '/perfil': 'settings',
    '/ajustes': 'settings',
  };
  const activeId = navMap[path] || 'dashboard';

  document.querySelectorAll('.nav-btn').forEach(btn => {
    const nav = btn.dataset.nav;
    if (nav === activeId) {
      btn.style.background = 'linear-gradient(145deg, #ff7db2, #e9509d 60%, #c48afc)';
      btn.style.color = 'white';
      btn.style.boxShadow = '0 -5px 18px rgba(255,77,148,0.30), 0 8px 24px rgba(200,80,160,0.28)';
      btn.style.transform = 'translateY(-0.625rem) scale(1.05)';
      btn.style.padding = '0.625rem 1.25rem';
    }
  });

  document.getElementById('nav-logout')?.addEventListener('click', () => {
    localStorage.removeItem('token');
    localStorage.removeItem('user');
    window.location.href = '/';
  });

  // Check auth
  const user = JSON.parse(localStorage.getItem('user'));
  if (!user) {
    window.location.href = '/login';
  }
</script>

<style>
  @media (min-width: 640px) {
    .nav-label { display: block !important; }
  }
</style>
