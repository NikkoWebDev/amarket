---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
---

<DashboardLayout title="Feedback - BoomLab" description="Comunicación con el equipo">
  <div id="feedback-root" class="min-h-screen p-4 sm:p-6" style="max-width: 1280px; margin: 0 auto;">
    <div id="feedback-app"></div>
  </div>
</DashboardLayout>

<script>
const API = window.location.origin + '/api';

function api(url, opts = {}) {
  const token = localStorage.getItem('token');
  const headers = { 'Content-Type': 'application/json', ...(token ? { Authorization: `Bearer ${token}` } : {}), ...opts.headers };
  return fetch(url, { ...opts, headers }).then(async r => {
    if (r.status === 401) { localStorage.removeItem('token'); localStorage.removeItem('user'); window.location.href = '/'; }
    if (!r.ok) { const e = await r.json().catch(() => ({ error: 'Error' })); throw new Error(e.error || 'Error'); }
    return r.json();
  });
}

const user = JSON.parse(localStorage.getItem('user'));
if (!user) window.location.href = '/login';

const app = document.getElementById('feedback-app');

let projects = [];
let selectedProject = null;
let messages = [];
let input = '';
let sending = false;

async function loadProjects() {
  try {
    let allProjects = [];
    if (user.rol === 'admin') allProjects = await api(API + '/proyectos');
    else if (user.rol === 'cliente') {
      const data = await api(API + '/proyectos');
      allProjects = data.filter(p => p.id_cliente === user.id_usuario);
    } else if (user.rol === 'empleado') {
      try {
        const assignments = await api(API + '/asignaciones');
        const ids = assignments.filter(a => a.id_empleado === user.id_usuario).map(a => a.id_proyecto);
        const data = await api(API + '/proyectos');
        allProjects = data.filter(p => ids.includes(p.id));
      } catch { allProjects = []; }
    }
    const withFeedback = await Promise.all(allProjects.map(async p => {
      try { const d = await api(API + '/proyectos/' + p.id_proyecto); return { ...p, feedback: d.feedback || [] }; }
      catch { return { ...p, feedback: [] }; }
    }));
    projects = withFeedback;
    if (withFeedback.length > 0 && !selectedProject) {
      selectedProject = withFeedback[0];
      messages = withFeedback[0].feedback || [];
    }
    render();
  } catch (e) { console.error(e); }
}

function selectProject(p) {
  selectedProject = p;
  messages = p.feedback || [];
  render();
}

async function handleSend() {
  if (!input.trim() || !selectedProject || sending) return;
  sending = true;
  try {
    await api(API + '/feedback', {
      method: 'POST',
      body: JSON.stringify({ id_proyecto: selectedProject.id_proyecto, mensaje: input.trim(), autor: user.nombre, rol: user.rol })
    });
    messages = [...messages, { mensaje: input.trim(), autor: user.nombre, rol: user.rol, fecha: new Date().toISOString() }];
    input = '';
    await loadProjects();
    render();
  } catch (e) { console.error(e); }
  finally { sending = false; }
}

function render() {
  app.innerHTML = `
    <div style="margin-bottom: 2rem;">
      <h1 style="font-family: 'Playfair Display', serif; font-size: 1.875rem; color: #38324f; margin: 0 0 0.25rem;">Feedback</h1>
      <p style="font-size: 0.875rem; color: #7d7599;">Comunicación con el equipo</p>
    </div>
    <div style="display: grid; grid-template-columns: 1fr 2fr; gap: 1.5rem; height: calc(100vh - 280px);">
      <div style="background: rgba(255,255,255,0.7); backdrop-filter: blur(12px); border: 1px solid rgba(245,220,233,0.8); border-radius: 1.5rem; display: flex; flex-direction: column; overflow: hidden;">
        <div style="padding: 1rem; border-bottom: 1px solid #e5d9e6;">
          <h3 style="font-family: 'Playfair Display', serif; color: #38324f; margin: 0; font-size: 1.125rem;">Proyectos</h3>
        </div>
        <div style="flex: 1; overflow-y: auto; padding: 0.75rem;">
          ${projects.length === 0 ? '<div style="text-align: center; padding: 2rem; color: #7d7599; font-size: 0.875rem;">No hay proyectos</div>' : projects.map(p => `
            <button onclick="(${selectProject.toString()})(${JSON.stringify(p).replace(/"/g, '&quot;')})" style="width: 100%; text-align: left; padding: 0.75rem; border-radius: 1rem; border: none; background: ${selectedProject?.id_proyecto === p.id_proyecto ? '#fff0f7' : 'transparent'}; cursor: pointer; margin-bottom: 0.25rem; transition: background 0.2s;">
              <div style="display: flex; align-items: center; gap: 0.75rem;">
                <div style="width: 2.5rem; height: 2.5rem; border-radius: 0.75rem; background: linear-gradient(135deg, #f66aac, #ff8bc3); display: flex; align-items: center; justify-content: center; color: white; font-weight: 700; font-size: 0.875rem; flex-shrink: 0;">${p.titulo?.charAt(0)?.toUpperCase() || 'P'}</div>
                <div style="flex: 1; min-width: 0;">
                  <p style="font-weight: 600; font-size: 0.875rem; color: #38324f; margin: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">${p.titulo}</p>
                  <p style="font-size: 0.75rem; color: #7d7599; margin: 0;">${p.nombre_cliente}</p>
                </div>
              </div>
            </button>
          `).join('')}
        </div>
      </div>
      <div style="background: rgba(255,255,255,0.7); backdrop-filter: blur(12px); border: 1px solid rgba(245,220,233,0.8); border-radius: 1.5rem; display: flex; flex-direction: column; overflow: hidden;">
        ${selectedProject ? `
          <div style="padding: 1rem; border-bottom: 1px solid #e5d9e6; display: flex; align-items: center; gap: 0.75rem;">
            <div style="width: 2.5rem; height: 2.5rem; border-radius: 0.75rem; background: linear-gradient(135deg, #8b5cf6, #a855f7); display: flex; align-items: center; justify-content: center; color: white; font-weight: 700; font-size: 0.875rem;">${selectedProject.titulo?.charAt(0)?.toUpperCase() || 'P'}</div>
            <div style="flex: 1;"><h3 style="font-family: 'Playfair Display', serif; color: #38324f; margin: 0; font-size: 1.125rem;">${selectedProject.titulo}</h3><p style="font-size: 0.75rem; color: #7d7599; margin: 0;">${selectedProject.nombre_cliente}</p></div>
          </div>
          <div style="flex: 1; overflow-y: auto; padding: 1rem;">
            ${messages.length === 0 ? `
              <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%; color: #7d7599;">
                <svg viewBox="0 0 24 24" fill="none" style="width: 3rem; height: 3rem; margin-bottom: 0.75rem; opacity: 0.4;" stroke="currentColor" stroke-width="1.5"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                <p style="font-size: 0.875rem;">No hay mensajes aún</p>
                <p style="font-size: 0.75rem; margin-top: 0.25rem;">Sé el primero en comentar</p>
              </div>
            ` : messages.map(msg => `
              <div style="display: flex; ${msg.rol === user.rol ? 'justify-content: flex-end;' : 'justify-content: flex-start;'} margin-bottom: 0.75rem;">
                <div style="max-width: 80%; border-radius: 1rem; padding: 0.5rem 1rem; ${msg.rol === user.rol ? 'background: linear-gradient(135deg, #f66aac, #ff8bc3); color: white;' : 'background: rgba(255,255,255,0.7); border: 1px solid #e5d9e6; color: #38324f;'}">
                  <p style="margin: 0; font-size: 0.875rem;">${msg.mensaje}</p>
                  <div style="display: flex; align-items: center; gap: 0.5rem; margin-top: 0.25rem; font-size: 0.625rem; ${msg.rol === user.rol ? 'color: rgba(255,255,255,0.7);' : 'color: #7d7599;'}">
                    <span style="font-weight: 600;">${msg.autor}</span>
                    <span>·</span>
                    <span>${new Date(msg.fecha).toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' })}</span>
                  </div>
                </div>
              </div>
            `).join('')}
          </div>
          ${user.rol === 'cliente' ? `
            <div style="padding: 1rem; border-top: 1px solid #e5d9e6;">
              <div style="display: flex; gap: 0.5rem;">
                <input type="text" id="feedback-input" value="${input}" placeholder="Escribe un mensaje..." onkeydown="if(event.key==='Enter'&&!event.shiftKey){event.preventDefault();handleSend()}" oninput="input=this.value" style="flex: 1; padding: 0.5rem 1rem; border-radius: 0.75rem; border: 1px solid rgba(245,220,233,0.8); background: rgba(255,255,255,0.5); font-size: 0.875rem; color: #38324f; outline: none;">
                <button onclick="handleSend()" disabled="${sending || !input.trim()}" style="padding: 0.5rem; background: linear-gradient(135deg, #f66aac, #ff8bc3); color: white; border: none; border-radius: 0.75rem; cursor: pointer;">
                  <svg viewBox="0 0 24 24" fill="none" style="width: 1.25rem; height: 1.25rem;" stroke="currentColor" stroke-width="2"><path d="m22 2-7 20-4-9-9-4 20-7z"/></svg>
                </button>
              </div>
            </div>
          ` : ''}
        ` : `
          <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%; color: #7d7599;">
            <svg viewBox="0 0 24 24" fill="none" style="width: 4rem; height: 4rem; margin-bottom: 1rem; opacity: 0.4;" stroke="currentColor" stroke-width="1.5"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            <p style="font-size: 1.125rem; font-weight: 600;">Selecciona un proyecto</p>
            <p style="font-size: 0.875rem; margin-top: 0.25rem;">Elige un proyecto para ver su feedback</p>
          </div>
        `}
      </div>
    </div>
  `;
}

loadProjects();
</script>
