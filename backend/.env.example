# Database configuration for local MySQL (development)
DB_HOST=localhost
DB_PORT=3306
DB_USER=app_user
DB_PASSWORD=app_password_123
DB_NAME=gestion_proyectos

# Render PostgreSQL configuration (production)
# INTERNAL_DATABASE_URL is used for internal connections within Render's network.
# EXTERNAL_DATABASE_URL is used for external connections.
INTERNAL_DATABASE_URL=postgresql://<user>:<password>@<host>/<database>
EXTERNAL_DATABASE_URL=postgresql://<user>:<password>@<host>.virginia-postgres.render.com/<database>

# JWT
JWT_SECRET=tu_secreto_jwt_aqui
JWT_EXPIRES_IN=24h

# Server
PORT=4000

# OpenRouter AI API
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=tencent/hy3-preview:free
